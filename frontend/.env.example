# Local: vacío (Vite proxya /health, /auth, /tasks, /ws, /uploads).
# El puerto del proxy se toma de backend/.env (PORT); por defecto 3001.
VITE_API_URL=

# VPS: origen de la API, una sola vez. Si nginx expone el backend en /api:
# VITE_API_URL=https://tasks.prestamo911.com/api

# Solo para probar push/PWA en vite: npm run dev:https:pwa (DEV_PWA=1).
# Con SW en Safari iOS el origen local se puede corromper → pantalla en blanco.
