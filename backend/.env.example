PORT=3001
HOST=0.0.0.0
JWT_SECRET=cambia-esta-clave-en-local
JWT_EXPIRES_IN=7d

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=alex
DB_PASSWORD=
DB_NAME=test_agenda
# Si MariaDB autentica por socket Unix, deja esta línea:
DB_SOCKET=/run/mysqld/mysqld.sock

OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini

# Orígenes del frontend en el VPS (separados por coma). Sin esto, solo localhost y LAN.
# Ejemplo: CORS_ORIGIN=https://agenda.tudominio.com,http://TU_IP
CORS_ORIGIN=

# Avisos push de la PWA. Genera un par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:agenda@localhost
# La hora de aviso se interpreta en la zona del servidor. En México:
# TZ=America/Mexico_City
